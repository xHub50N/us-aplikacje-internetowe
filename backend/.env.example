# Database connection URL
DATABASE_URL="postgresql://appuser:devpassword@localhost:5432/myapp?schema=public"

# Application port
PORT=3001

# JWT Secret for authentication tokens
JWT_SECRET="replace-with-a-secure-random-secret"

# Email / SMTP Configuration
# For local dev with Mailpit:
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Task Manager" <no-reply@taskmanager.local>
EMAIL_ENABLED=true
FRONTEND_URL=http://localhost:3000

# For external SMTP providers (e.g. SendGrid, Resend, Amazon SES, Brevo):
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=your-api-key
# EMAIL_FROM="Your App" <notifications@yourdomain.com>
